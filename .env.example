# Copy to .env and fill in. Used by docker-compose.prod.yml.

# --- backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://clocklog:change-me@db:5432/clocklog
# Auth rate limiting (per IP, sliding window)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Tighter window for the endpoints that send mail (register, resend-verification,
# forgot-password). Keyed per IP and per email address.
AUTH_EMAIL_RATE_LIMIT=3
AUTH_EMAIL_RATE_WINDOW_SECONDS=3600

# --- email (Resend) ---
# Leave RESEND_API_KEY empty to disable sending; the backend then logs the
# verification / reset link instead. That is the dev and CI setting, never prod.
RESEND_API_KEY=
# Must be on a domain verified in Resend, with SPF and DKIM published.
EMAIL_FROM=ClockLog <no-reply@example.com>
# Origin the emailed links point at: the FRONTEND, not the API.
APP_BASE_URL=https://app.example.com
# Comma-separated origins allowed to call the API (CORS). Prod: the origin
# nginx serves the frontend from; the API needs it when it is reached
# cross-origin. Dev default is http://localhost:3000.
CORS_ORIGINS=https://app.example.com

# --- database ---
POSTGRES_USER=clocklog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clocklog

# --- frontend ---
# Public URL through which nginx exposes the API (baked in at build time).
NEXT_PUBLIC_API_URL=https://api.example.com

# --- backups ---
# Seconds between dumps; keep N local copies.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
# Optional rclone remote to copy dumps off-site, e.g. "b2:clocklog-backups".
# Leave empty for local-only backups. Credentials go in rclone.conf
# (mount it in docker-compose.prod.yml).
BACKUP_RCLONE_REMOTE=
