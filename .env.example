# Copy to .env and fill in. Used by docker-compose.prod.yml.

# --- backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://tempo:change-me@db:5432/tempo
# Auth rate limiting (per IP, sliding window)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

# --- database ---
POSTGRES_USER=tempo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tempo

# --- frontend ---
# Public URL through which nginx exposes the API (baked in at build time).
NEXT_PUBLIC_API_URL=https://api.example.com

# --- backups ---
# Seconds between dumps; keep N local copies.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14
# Optional rclone remote to copy dumps off-site, e.g. "b2:tempo-backups".
# Leave empty for local-only backups. Credentials go in rclone.conf
# (mount it in docker-compose.prod.yml).
BACKUP_RCLONE_REMOTE=
