# Copy to .env and fill in. Each variable is marked requerida (the compose
# base fails at `docker compose config` while it is missing) u opcional with
# its default.
#
# Also works for development: `cp .env.example .env` — docker-compose.override.yml
# replaces the runtime values with local clocklog/clocklog credentials and an
# empty RESEND_API_KEY, so these placeholders only need to exist for the base
# file's ${VAR:?...} interpolation to resolve.

# --- backend ---
# requerida. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# requerida. Host `db` is the Compose service name.
DATABASE_URL=postgresql+asyncpg://clocklog:change-me@db:5432/clocklog
# opcional (default: 10). Auth rate limit per IP, sliding window.
LOGIN_RATE_LIMIT=10
# opcional (default: 60)
LOGIN_RATE_WINDOW_SECONDS=60
# opcional (default: 3). Tighter window for the endpoints that send mail
# (register, resend-verification, forgot-password). Keyed per IP and per email.
AUTH_EMAIL_RATE_LIMIT=3
# opcional (default: 3600)
AUTH_EMAIL_RATE_WINDOW_SECONDS=3600

# --- email (Resend) ---
# requerida en prod; opcional en dev/CI (vacío = no envía, loguea el link).
# docker-compose.prod.yml la exige con :? para el comando legacy de dos -f.
RESEND_API_KEY=
# requerida. Must be on a domain verified in Resend, with SPF and DKIM published.
EMAIL_FROM=ClockLog <no-reply@example.com>
# requerida. Origin the emailed links point at: the FRONTEND, not the API.
APP_BASE_URL=https://app.example.com
# requerida. Comma-separated origins allowed to call the API (CORS). Dev:
# http://localhost:3000. Prod: the origin nginx serves the frontend from.
CORS_ORIGINS=https://app.example.com

# --- database ---
# requeridas (las tres): credenciales del contenedor Postgres.
POSTGRES_USER=clocklog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clocklog

# --- frontend ---
# requerida. Public URL through which nginx exposes the API — baked into the
# client bundle at build time; changing it requires a rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://api.example.com

# --- dev/CI only ---
# Opcional en .env: docker-compose.override.yml fija el valor dev literal.
# Must end in _test (tests/conftest.py enforces it).
# TEST_DATABASE_URL=postgresql+asyncpg://clocklog:change-me@db:5432/clocklog_test

# --- backups ---
# opcional (default: 86400). Seconds between dumps.
BACKUP_INTERVAL_SECONDS=86400
# opcional (default: 14). Local copies kept (daily dumps ≈ two weeks).
BACKUP_KEEP=14
# opcional (default: vacío). Vacío = solo local, aceptado conscientemente:
# verificar con `docker compose logs backup | tail` y probar un restore.
# Con valor = copia off-site vía rclone, p. ej. "b2:clocklog-backups".
# Credentials go in rclone.conf (mount it in docker-compose.yml, commented).
BACKUP_RCLONE_REMOTE=
