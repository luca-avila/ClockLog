# Copy to .env and fill in. Each variable is marked required (the compose
# base fails at `docker compose config` while it is missing or empty) or
# optional with its default. `.env` is gitignored; dev and prod pass it to
# Compose for interpolation, and CI injects the same values as step-level env.
#
# Development: `cp .env.example .env` — docker-compose.override.yml replaces
# the runtime values with local clocklog/clocklog credentials and an empty
# RESEND_API_KEY, so these placeholders only need to exist for the base file's
# ${VAR:?...} interpolation to resolve. RESEND_API_KEY included: the base
# requires a non-empty value for interpolation, so dev/CI keep a non-secret
# placeholder here and the override makes the container's runtime value empty
# (sender logs the link; tests require the empty runtime key). That includes
# NEXT_PUBLIC_API_URL even though the frontend does not run in Compose in dev:
# profile-excluded services are still interpolated by `docker compose config`.

# --- backend ---
# required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# required. Host `db` is the Compose service name.
DATABASE_URL=postgresql+asyncpg://clocklog:change-me@db:5432/clocklog
# optional (default: 10). Auth rate limit per IP, sliding window.
LOGIN_RATE_LIMIT=10
# optional (default: 60)
LOGIN_RATE_WINDOW_SECONDS=60
# optional (default: 3). Tighter window for the endpoints that send mail
# (register, resend-verification, forgot-password). Keyed per IP and per email.
AUTH_EMAIL_RATE_LIMIT=3
# optional (default: 3600)
AUTH_EMAIL_RATE_WINDOW_SECONDS=3600

# --- email (Resend) ---
# required (the base uses :? like for the rest). In dev/CI a NON-secret
# placeholder is enough: the override pins the runtime to empty, so the sender
# logs the link instead of sending (and conftest — empty key mandatory in
# tests — stays green). In prod, replace it with the real key: a placeholder
# boots the deploy and sending only fails at runtime with a Resend auth error.
RESEND_API_KEY=change-me-resend-placeholder
# required. Must be on a domain verified in Resend, with SPF and DKIM published.
EMAIL_FROM=ClockLog <no-reply@example.com>
# required. Origin the emailed links point at: the FRONTEND, not the API.
APP_BASE_URL=https://app.example.com
# required. Comma-separated origins allowed to call the API (CORS). Dev:
# http://localhost:3000. Prod: the origin nginx serves the frontend from.
CORS_ORIGINS=https://app.example.com

# --- database ---
# required (all three): Postgres container credentials.
POSTGRES_USER=clocklog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clocklog

# --- frontend ---
# required. Public URL through which nginx exposes the API — baked into the
# client bundle at build time; changing it requires a rebuild, not a restart.
# In dev it only needs to exist (frontend runs on the host, not in Compose).
NEXT_PUBLIC_API_URL=https://api.example.com

# --- dev/CI only ---
# Optional in .env: docker-compose.override.yml pins the literal dev value.
# Must end in _test (tests/conftest.py enforces it).
# TEST_DATABASE_URL=postgresql+asyncpg://clocklog:change-me@db:5432/clocklog_test

# --- backups ---
# optional (default: 86400). Seconds between dumps.
BACKUP_INTERVAL_SECONDS=86400
# optional (default: 14). Local copies kept (daily dumps ≈ two weeks). The
# default only applies when the variable is absent — if the real .env sets a
# lower value (e.g. 2), that wins. Raise it in the prod .env; the compose
# default alone is not enough.
BACKUP_KEEP=14
# optional (default: empty). Empty = local-only, a conscious choice: verify
# with `docker compose logs backup | tail` and test a restore. With a value =
# off-site copy via rclone, e.g. "b2:clocklog-backups".
# Credentials go in rclone.conf (mount it in docker-compose.yml, commented).
BACKUP_RCLONE_REMOTE=
